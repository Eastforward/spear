      "sha256": "5f6baee716be62aeb53014ede20d2e1baabc76eb2c2fabcda6a9ea88ff26a4e3",
      "speaker_id": "4750",
      "gender": "male",
      "language": "en",
      "official_transcript": "The Sedition Of Corah And Of The Multitude Against Moses, And Against His Brother, Concerning The Priesthood.",
      "license": "CC BY 4.0",
      "license_name": "Creative Commons Attribution 4.0 International",
      "license_status": "verified_from_dataset_license",
      "human_listening_result": "passed",
